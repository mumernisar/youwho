{
  "name": "youwho",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "check:decoder": "tsx scripts/check-decoder.ts",
    "seed:fixture": "tsx --env-file=.env scripts/seed-fixture.ts",
    "db:generate": "pnpm --filter @youwho/db db:generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "zod": "4.6.7",
    "@youwho/core": "workspace:*",
    "@youwho/db": "workspace:*"
  }
}
